{
    "manifest_version": 3,
    "name": "AI Translator",
    "version": "1.1",
    "description": "Gemini-powered Chrome extension for smart translations. Features Professional/Casual/Concise tones, right-click access, and keyboard shortcuts.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "contextMenus"
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "AI Translator Settings"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ]
        }
    ],
    "commands": {
        "translate-selection": {
            "suggested_key": {
                "default": "Alt+T",
                "mac": "Alt+T"
            },
            "description": "Translate selected text"
        }
    }
}